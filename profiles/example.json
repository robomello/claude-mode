{
  "bedrock": {
    "base_url": "http://localhost:8104",
    "port": 8104
  },
  "local": {
    "base_url": "http://localhost:8901",
    "port": 8901
  },
  "models": {
    "oauth": {
      "opus": "your-oauth-opus-model-id",
      "sonnet": "your-oauth-sonnet-model-id",
      "haiku": "your-oauth-haiku-model-id",
      "small_fast": "your-oauth-haiku-model-id"
    },
    "nexus": {
      "opus": "your-opus-model-id",
      "sonnet": "your-sonnet-model-id",
      "haiku": "your-haiku-model-id",
      "small_fast": "your-haiku-model-id"
    },
    "gpt": {
      "opus": "your-gpt-opus-model-id",
      "sonnet": "your-gpt-sonnet-model-id",
      "haiku": "your-gpt-haiku-model-id",
      "small_fast": "your-gpt-haiku-model-id"
    },
    "local": {
      "opus": "your-local-opus-model-id",
      "sonnet": "your-local-sonnet-model-id",
      "haiku": "your-local-haiku-model-id",
      "small_fast": "your-local-haiku-model-id"
    }
  },
  "claude_model": {
    "oauth": null,
    "nexus": null,
    "gpt": null,
    "local": null
  },
  "tokens": {
    "bedrock_env": "AWS_BEARER_TOKEN_BEDROCK",
    "env_file": null
  },
  "test": {
    "timeout_seconds": 20
  },
  "tunnel": {
    "host": "your-server.example.com",
    "user": null,
    "jump": null
  },
  "toggle_cycle": ["oauth", "nexus", "gpt", "local"]
}
